   "source": [
    "# 🚀 SP_LAB 量化回測平台 Colab 快速啟動器\\n",
    "\\n",
    "歡迎使用！本 Notebook 旨在提供一個一鍵執行的環境，讓您可以輕鬆地在 Google Colab 上運行 `sp_lab` 的完整回測流程。\\n",
    "\\n",
    "**操作步驟：**\\n",
    "1. **設定參數**：在下方的「環境設定」儲存格中，確認 GitHub URL 與要測試的分支名稱。\\n",
    "2. **依序執行**：點擊每個儲存格左側的 ▶️ 按鈕，從上到下依次執行。\\n",
    "3. **查看結果**：在「一鍵執行完整回測」儲存格的輸出區，您將會看到最終的權益曲線圖與績效指標。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "id": "setup-environment",
    "outputId": "a1b2c3d4-e5f6-a7b8-c9d0-e1f2a3b4c5d6",
    "title": "1. 環境設定：同步專案並安裝套件"
   },
   "outputs": [],
   "source": [
    "import os\\n",
    "import sys\\n",
    "\\n",
    "#@markdown ### **1. 設定 GitHub 儲存庫**\\n",
    "GITHUB_REPO_URL = \\"https://github.com/hsp1234-web/sp_lab.git\\" #@param {type:\\"string\\"}\\n",
    "\\n",
    "#@markdown ### **2. 輸入要測試的分支名稱**\\n",
    "GIT_BRANCH = \\"1.9\\" #@param {type:\\"string\\"}\\n",
    "\\n",
    "print(f\\"🔄 正在準備環境...\\")\\n",
    "\\n",
    "# --- 1. 同步 GitHub 專案 ---
    "repo_name = GITHUB_REPO_URL.split('/')[-1].replace('.git', '')\\n",
    "local_repo_path = os.path.join('/content', repo_name)\\n",
    "\\n",
    "if os.path.exists(local_repo_path):\\n",
    "    print(f\\"🌀 專案資料夾已存在，正在更新至 '{GIT_BRANCH}' 分支...\\")\\n",
    "    %cd {local_repo_path}\\n",
    "    !git fetch -q origin\\n",
    "    !git checkout -q {GIT_BRANCH}\\n",
    "    !git pull -q origin {GIT_BRANCH}\\n",
    "    %cd /content\\n",
    "else:\\n",
    "    print(f\\"✨ 專案資料夾不存在，正在從 '{GIT_BRANCH}' 分支下載...\\")\\n",
    "    !git clone -q --branch {GIT_BRANCH} {GITHUB_REPO_URL}\\n",
    "\\n",
    "print(f\\"✅ 程式碼同步完成！專案路徑: {local_repo_path}\\")\\n",
    "\\n",
    "# --- 2. 安裝 Python 套件 (使用 uv) ---
    "requirements_path = os.path.join(local_repo_path, 'requirements.txt')\\n",
    "if not os.path.exists(requirements_path):\\n",
    "    print(f\\"⚠️ 警告：在 '{requirements_path}' 中找不到 requirements.txt 檔案。\\")\\n",
    "else:\\n",
    "    print(\\"📦 正在安裝相依套件...\\")\\n",
    "    !pip install -q uv\\n",
    "    !uv pip install -q -r {requirements_path}\\n",
    "    print(\\"✅ 所有套件安裝完畢！\\")\\n",
    "\\n",
    "# --- 3. 將專案路徑加入系統 ---
    "sys.path.insert(0, local_repo_path)\\n",
    "print(f\\"🐍 已將專案路徑加入 Python 執行環境。\\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "id": "run-backtest",
    "outputId": "f1e2d3c4-b5a6-f7e8-d9c0-a1b2c3d4e5f6",
    "title": "2. 一鍵執行完整回測"
   },
   "outputs": [],
   "source": [
    "import os\\n",
    "from IPython.display import Image, display\\n",
    "\\n",
    "# --- 執行主流程 ---
    "repo_name = \\"sp_lab\\" # 根據上一步驟的 repo_name\\n",
    "main_script_path = f\\"/content/{repo_name}/src/main.py\\"\\n",
    "\\n",
    "if not os.path.exists(main_script_path):\\n",
    "    print(f\\"❌ 錯誤：找不到主執行檔 '{main_script_path}'。請確認上一步是否成功執行。\\")\\n",
    "else:\\n",
    "    print(f\\"🚀 即將執行主回測流程...\\")\\n",
    "    # 我們需要進入 src 目錄來執行 main.py，以確保相對匯入能正常運作\\n",
    "    %cd /content/{repo_name}/src\\n",
    "    !python main.py\\n",
    "    %cd /content\\n",
    "    print(\\"🏁 回測流程結束。\\")\\n",
    "    \\n",
    "    # --- 顯示結果 ---
    "    print(\\"\\n📊 正在顯示回測結果...\\")\\n",
    "    equity_curve_path = f\\"/content/{repo_name}/src/output/results/equity_curve.jpg\\"\\n",
    "    if os.path.exists(equity_curve_path):\\n",
    "        print(\\"\\n--- 權益曲線圖 ---\\")\\n",
    "        display(Image(filename=equity_curve_path))\\n",
    "    else:\\n",
    "        print(f\\"⚠️ 警告：找不到權益曲線圖檔案於 '{equity_curve_path}'。\\")"
   ]
  }
